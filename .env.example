# QQ 官方 Webhook 接入，需将公网 HTTPS 回调反向代理到本服务。
DRIVER=~fastapi+~httpx
HOST=127.0.0.1
PORT=8080
COMMAND_START=["", "/"]
QQ_IS_SANDBOX=false
QQ_VERIFY_WEBHOOK=true
# id 为 AppID；secret 为 AppSecret；token 为后台 Token（仅旧接口需要，无则留空）。
QQ_BOTS=[{"id":"填写AppID","token":"","secret":"填写AppSecret","use_websocket":false,"intent":{"c2c_group_at_messages":true}}]
# 在群内 @机器人 我的身份，复制返回的 AppID:用户OpenID，填写后重启。
# 这里不能填写普通 QQ 号。未配置时无人有管理权限。
GW_ADMINS=[]
# 主动消息受官方权限/额度约束，默认关闭；手动 @机器人 催刀仍可用。
GW_ENABLE_PROACTIVE_REMINDERS=false
# 按 AppID 配置群 OpenID；不是数字 QQ 群号。
GW_REMINDER_TARGETS={}
