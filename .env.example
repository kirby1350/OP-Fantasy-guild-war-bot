# 复制为 .env 后修改
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# 指令前缀：允许直接发送「报刀 100」，也兼容「/报刀 100」
COMMAND_START=["/", ""]

# 协议端（NapCat 等）使用反向 WebSocket 连接：
#   ws://127.0.0.1:8080/onebot/v11/ws
# 如需正向 WebSocket，将 DRIVER 改为 ~fastapi+~websockets 并配置：
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# 超级用户 QQ 号（你自己的号，不是机器人号）
SUPERUSERS=["123456789"]

# 工会群号（定时催刀发送到此群）
GW_GROUP_ID=987654321
